# Environment files
.env

# IDE / Editor files
.cursorrules
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# Dependencies
node_modules/
vendor/

# Test artifacts
.phpunit.cache/
composer.lock

# Local SQLite database — config/database.php defaults DB_DATABASE to this path when
# DB_DRIVER=sqlite, so it appears for anyone taking the documented SQLite option.
/storage/database.sqlite

# Build artifacts — generated by `npm install` (its postinstall runs `npm run build:all`).
# Deliberately NOT committed. A committed build silently goes stale: Tailwind emits only
# the utility classes it finds while scanning templates, so a stylesheet built against
# older markup omits whatever the current views use and the page renders unstyled rather
# than erroring. Build them, don't track them. Sources stay tracked in app/client/src/.
/public/assets/css/
/public/assets/js/
/public/assets/fonts/

# OS files
.DS_Store
Thumbs.db

# Development Resources (remove negation to ignore)
!resources/**

# Logs and cache (already handled by subdirectory .gitignore files)
# storage/logs/
# storage/cache/
# storage/userfiles/
