# ---------------------------------------------
# Core settings
# ---------------------------------------------
Options -Indexes
RewriteEngine On
RewriteBase /

# Improve security
<IfModule mod_headers.c>
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-Content-Type-Options nosniff
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://qsrbrands.com; font-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>

# ---------------------------------------------
# 1. Serve existing files/directories as-is
# ---------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------
# 2. API Routing (shared backend)
# ---------------------------------------------
RewriteRule ^api/(.*)$    /index.php?api=$1  [QSA,L]

# ---------------------------------------------
# 3. App Routing (UI pages)
# ---------------------------------------------
# Route all other requests through the app router
RewriteRule ^(.*)$ index.php?path=$1 [QSA,L]
