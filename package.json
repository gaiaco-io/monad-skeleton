{
  "name": "Monad Framework Skeleton",
  "version": "3.0.0",
  "description": "Skeleton for the Monad Framework",
  "keywords": [
    "Monad Framework skeleton",
    "PHP framework skeleton",
    "MVC framework skeleton"
  ],
  "license": "MIT",
  "author": "Marshal Yung <marshal.yung@gaiaco.io>",
  "type": "project",
  "main": "public/index.php",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./app/client/src/css/styles.css -o ./public/assets/css/styles.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./app/client/src/css/styles.css -o ./public/assets/css/styles.css --watch",
    "build:assets": "node scripts/copy-assets.js",
    "build:all": "npm run build:css && npm run build:assets",
    "postinstall": "npm run build:all"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@preline/datatable": "^3.2.3",
    "chart.js": "^4.5.1",
    "datatables.net-dt": "^2.3.5",
    "dotenv": "^17.2.2",
    "jquery": "^3.7.1",
    "preline": "^3.2.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.8.1",
    "esbuild": "^0.27.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
