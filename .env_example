# Environment mode
ENV_MODE=development  # or production
APP_SECRET=

# Deployment environment
APP_NAME=
TIMEZONE=UTC
BASE_URL=http://localhost
SESSION_TIMEOUT=1800

# Single domain cookie
COOKIE_DOMAIN=

# Database configuration — DB_DRIVER: mysql (default), pgsql, or sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# CORS (App\Middlewares\CORS) — comma-separated origins; empty means allow-all
CORS_ALLOWED_ORIGINS=

# LLM provider keys (Services\LLMAdapters\*) — set only the ones actually used
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Google SSO (App\Middlewares\Authentication) — leave blank to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3 storage adapter (Services\Files) — leave blank to use the filesystem adapter
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# SEO defaults (Middlewares\MetaTag — read directly via getenv(), used when a controller
# doesn't set a value explicitly via MetaTag::set())
SEO_DEFAULT_DESCRIPTION=
SEO_DEFAULT_IMAGE=/assets/img/og-default.png
SEO_TWITTER_SITE=
SEO_LOCALE=en_US
SEO_ORG_NAME=
SEO_ORG_LOGO=

# Mailer (application-owned; Clarity ships no Mail service)
MAILER_PROVIDER=
MAILER_API_KEY=
MAILER_SENDER_NAME=${APP_NAME}
MAILER_SENDER_EMAIL=

# Directory paths (relative to project root, or absolute)
CSS_DIR=public/assets/css/
JS_DIR=public/assets/js/
IMG_DIR=public/assets/img/
VIEW_DIR=app/views
CACHE_DIR=storage/cache/
UPLOAD_DIR=storage/userfiles/
ERROR_LOG_DIR=storage/logs/error/
EVENT_LOG_DIR=storage/logs/event/
