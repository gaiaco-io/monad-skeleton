# Environment mode
ENV_MODE=development  # or production
APP_SECRET=

# Deployment environment
APP_NAME=
TIMEZONE=Asia/Kuala_Lumpur
BASE_URL=http://localhost
SESSION_TIMEOUT=1800

#  Single domain cookie
COOKIE_DOMAIN=

#  Database configuration
DB_DRIVER=mysql
DB_PORT=3306

#  Database
DB_HOST=127.0.0.1
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=ripper2mysql

#  Mailer configurations
MAILER_PROVIDER=
MAILER_API_KEY=
MAILER_SENDER_NAME=${APP_NAME}
MAILER_SENDER_EMAIL=

#  AWS configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

#  Directory paths
CSS_DIR=public/assets/css/
JS_DIR=public/assets/js/
IMG_DIR=public/assets/img/
VIEW_DIR=app/views
CACHE_DIR=storage/cache/
UPLOAD_DIR=storage/userfiles/
ERROR_LOG_DIR=storage/logs/error/
EVENT_LOG_DIR=storage/logs/event/

#  LLM
LLM_SECRET_KEY=
LLM_API_URL=
LLM_MODEL=

#  SEO defaults (optional — used when controllers do not set values)
SEO_DEFAULT_DESCRIPTION=
SEO_DEFAULT_IMAGE=/assets/img/og-default.png
SEO_TWITTER_SITE=
SEO_LOCALE=en_US
SEO_ORG_NAME=
SEO_ORG_LOGO=
