# Environment mode
ENV_MODE=development  # or production
APP_SECRET=

# Deployment environment
APP_NAME=
TIMEZONE=UTC
BASE_URL=http://localhost
SESSION_TIMEOUT=1800

# Where the default layout's "Documentation" link points. Defaults to this repo's own
# GitHub page if unset — point it at your real docs site once you have one.
DOCS_URL=

# Single domain cookie
COOKIE_DOMAIN=

# Database configuration — DB_DRIVER: mysql (default), pgsql, or sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# CORS (App\Middlewares\CORS) — comma-separated origins; empty means allow-all
CORS_ALLOWED_ORIGINS=

# LLM provider keys (Services\LLMAdapters\*) — set only the ones actually used
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Google SSO (App\Middlewares\Authentication) — leave blank to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3 storage adapter (Services\Files) — leave blank to use the filesystem adapter
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# SEO defaults (Middlewares\MetaTag — read directly via getenv(), used when a controller
# doesn't set a value explicitly via MetaTag::set())
SEO_DEFAULT_DESCRIPTION=
SEO_DEFAULT_IMAGE=/assets/img/og-default.png
SEO_TWITTER_SITE=
SEO_LOCALE=en_US
SEO_ORG_NAME=
SEO_ORG_LOGO=

# Mailer (Monad\Clarity\Services\Mail — Clarity 1.6.0+; built in config/mail.php)
#
# One name for a single mailer, or a comma-separated list to fail over through them left to
# right. The list IS the failover setting — there is no separate flag.
#   MAIL_MAILERS=postmark
#   MAIL_MAILERS=postmark,resend,smtp
# Valid names: postmark, resend, sendgrid, mailgun, mailtrap, mailtrap_sandbox, smtp.
# Amazon SES takes an SDK client rather than a credential, so it is built in your own code.
MAIL_MAILERS=smtp

# The default sender. Mail\Message takes its `from` per message, so this is the application's
# own default rather than something Clarity reads.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=${APP_NAME}

# Fill in only the mailers named in MAIL_MAILERS above.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us          # us or eu — an EU account on the US host reports an unknown domain
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=         # sandbox only

# SMTP. Encryption is starttls (587), implicit (465), or none — none is for a local relay
# such as Mailpit and nothing else; it sends the password in the clear.
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=starttls

# Directory paths (relative to project root, or absolute)
CSS_DIR=public/assets/css/
JS_DIR=public/assets/js/
IMG_DIR=public/assets/img/
VIEW_DIR=app/views
CACHE_DIR=storage/cache/
UPLOAD_DIR=storage/userfiles/
ERROR_LOG_DIR=storage/logs/error/
EVENT_LOG_DIR=storage/logs/event/
