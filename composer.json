{
  "name": "gaia/monad-skeleton",
  "description": "Monad Framework application skeleton.",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Marshal Yung",
      "email": "marshal.yung@gaiaco.io"
    }
  ],
  "minimum-stability": "stable",
  "repositories": [
    {
      "type": "path",
      "url": "../Clarity"
    }
  ],
  "require": {
    "php": ">=8.2",
    "gaia/monad-clarity": "^1.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "resources/tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find app -name '*.php' -print0 | xargs -0 -L1 php -l"
  }
}
